{
  "name": "prophecy-app",
  "main": "expo-router/entry",
  "version": "0.18.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "WEB_OUTPUT=single expo start --web",
    "build:web": "expo export -p web && bun scripts/postbuild-web.ts",
    "lint": "expo lint",
    "build:catalogs": "bun scripts/build-catalogs.ts",
    "check:catalogs": "bun scripts/build-catalogs.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
